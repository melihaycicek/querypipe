{
  "suite": "sort-nulls-model",
  "description": "The reference NULL model (ADR-0008): NULL is larger than every value — asc ⇒ nulls last, desc ⇒ nulls first; explicit nulls first/last is absolute (not flipped by direction); missing properties are NULL; NULL ties fall to the stableBy tie-breaker.",
  "specVersion": 1,
  "schema": {
    "stableBy": "id",
    "fields": {
      "id": { "type": "number" },
      "price": { "type": "number" }
    }
  },
  "idField": "id",
  "cases": [
    {
      "name": "apply-asc-default-nulls-last",
      "op": "apply",
      "spec": { "filters": [], "sorts": [{ "field": "price", "direction": "asc", "priority": 1 }] },
      "rows": [
        { "id": 1, "price": 10 },
        { "id": 2, "price": null },
        { "id": 3, "price": 20 },
        { "id": 4 }
      ],
      "expect": { "ok": true, "ids": [1, 3, 2, 4] },
      "note": "id 4 has no price property — missing is NULL. NULL ties (2, 4) fall to id asc."
    },
    {
      "name": "apply-desc-default-nulls-first",
      "op": "apply",
      "spec": { "filters": [], "sorts": [{ "field": "price", "direction": "desc", "priority": 1 }] },
      "rows": [
        { "id": 1, "price": 10 },
        { "id": 2, "price": null },
        { "id": 3, "price": 20 },
        { "id": 4 }
      ],
      "expect": { "ok": true, "ids": [2, 4, 3, 1] }
    },
    {
      "name": "apply-asc-explicit-nullsfirst-is-absolute",
      "op": "apply",
      "spec": {
        "filters": [],
        "sorts": [{ "field": "price", "direction": "asc", "nulls": "first", "priority": 1 }]
      },
      "rows": [
        { "id": 1, "price": 10 },
        { "id": 2, "price": null },
        { "id": 3, "price": 20 },
        { "id": 4 }
      ],
      "expect": { "ok": true, "ids": [2, 4, 1, 3] }
    },
    {
      "name": "apply-desc-explicit-nullslast-is-absolute",
      "op": "apply",
      "spec": {
        "filters": [],
        "sorts": [{ "field": "price", "direction": "desc", "nulls": "last", "priority": 1 }]
      },
      "rows": [
        { "id": 1, "price": 10 },
        { "id": 2, "price": null },
        { "id": 3, "price": 20 },
        { "id": 4 }
      ],
      "expect": { "ok": true, "ids": [3, 1, 2, 4] }
    }
  ]
}
