{
  "suite": "operators-membership",
  "description": "in/notIn semantics: membership over the eq domain, notIn excludes NULL rows (SQL NOT IN parity), enum membership validated at parse, empty arrays rejected in the JSON path.",
  "specVersion": 1,
  "schema": {
    "stableBy": "id",
    "fields": {
      "id": { "type": "number" },
      "category": { "type": "enum", "values": ["phone", "laptop", "tablet"] },
      "price": { "type": "number" }
    }
  },
  "idField": "id",
  "cases": [
    {
      "name": "apply-in",
      "op": "apply",
      "spec": {
        "filters": [{ "kind": "condition", "field": "category", "op": "in", "value": ["phone", "tablet"] }],
        "sorts": []
      },
      "rows": [
        { "id": 1, "category": "phone" },
        { "id": 2, "category": "laptop" },
        { "id": 3, "category": "tablet" },
        { "id": 4, "category": null },
        { "id": 5 }
      ],
      "expect": { "ok": true, "ids": [1, 3] }
    },
    {
      "name": "apply-notin-excludes-null-rows",
      "op": "apply",
      "spec": {
        "filters": [{ "kind": "condition", "field": "category", "op": "notIn", "value": ["phone"] }],
        "sorts": []
      },
      "rows": [
        { "id": 1, "category": "phone" },
        { "id": 2, "category": "laptop" },
        { "id": 3, "category": "tablet" },
        { "id": 4, "category": null },
        { "id": 5 }
      ],
      "expect": { "ok": true, "ids": [2, 3] },
      "note": "SQL parity: x NOT IN (...) is UNKNOWN when x is NULL — null/missing rows are excluded."
    },
    {
      "name": "parse-notin",
      "op": "parse",
      "input": "filter=category:notIn:phone",
      "expect": {
        "ok": true,
        "spec": {
          "filters": [{ "kind": "condition", "field": "category", "op": "notIn", "value": ["phone"] }],
          "sorts": []
        }
      },
      "note": "in/notIn always carry an array value in the spec, even for a single item."
    },
    {
      "name": "parse-in-rejects-unknown-enum-member",
      "op": "parse",
      "input": "filter=category:in:phone,desk",
      "expect": { "ok": false, "errors": [{ "code": "INVALID_VALUE", "field": "category", "op": "in" }] }
    },
    {
      "name": "validate-in-rejects-empty-array",
      "op": "validate",
      "spec": {
        "filters": [{ "kind": "condition", "field": "category", "op": "in", "value": [] }],
        "sorts": []
      },
      "expect": { "ok": false, "errors": [{ "code": "INVALID_VALUE", "field": "category", "op": "in" }] }
    },
    {
      "name": "apply-in-numbers",
      "op": "apply",
      "spec": {
        "filters": [{ "kind": "condition", "field": "price", "op": "in", "value": [10, 30] }],
        "sorts": []
      },
      "rows": [
        { "id": 1, "price": 10 },
        { "id": 2, "price": 20 },
        { "id": 3, "price": 30 }
      ],
      "expect": { "ok": true, "ids": [1, 3] }
    }
  ]
}
