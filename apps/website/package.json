{
  "name": "querypipe-website",
  "private": true,
  "type": "module",
  "description": "Official landing page and docs site for querypipe. Not published; never affects the npm package.",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "pnpm --filter querypipe build",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:snippets": "node scripts/typecheck-snippets.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fumadocs-core": "^16.10.7",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.10.7",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "querypipe": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.17.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3"
  }
}
